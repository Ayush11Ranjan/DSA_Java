    import java.util.*;

public class Assignment2 {


    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        long[] A = new long[N];
        for (int i = 0; i < N; i++) {
            A[i] = sc.nextLong();
        }

        long K = sc.nextLong();

        long rem = A[0] % K;

        for (int i = 1; i < N; i++) {
            if (A[i] % K != rem) {
                System.out.println(-1);
                return;
            }
        }

        long[] B = new long[N];
        for (int i = 0; i < N; i++) {
            B[i] = (A[i] - rem) / K;
        }

        Arrays.sort(B);

        long median = B[N / 2];
        long operations = 0;

        for (long x : B) {
            operations += Math.abs(x - median);
        }

        System.out.println(operations);
    }
}

